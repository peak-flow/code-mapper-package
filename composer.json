{
    "name": "peak-flow/code-mapper-package",
    "description": "Laravel package for AI-powered class mapping to enable efficient AI queries with smaller context windows",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "PeakFlow\\CodeMapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PeakFlow\\CodeMapper\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Peak Flow"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^9.0|^10.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0",
        "phpunit/phpunit": "^9.0|^10.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "PeakFlow\\CodeMapper\\CodeMapperServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
